# Supabase Configuration (required)
NEXT_PUBLIC_SUPABASE_URL="https://your_project_id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# API oficial de tarefas: no deploy da API web, ambas começam desligadas.
# Ative cada uma somente após validar o fluxo correspondente no ambiente alvo.
OMNIA_INTEGRATIONS_READ_ENABLED="false"
OMNIA_INTEGRATIONS_WRITE_ENABLED="false"
# Mesmo segredo de alta entropia, configurado somente nos ambientes de servidor
# da API web e do projeto MCP. Substitua o placeholder no gerenciador de segredos.
OMNIA_MCP_EXCHANGE_SECRET="replace-with-random-server-only-secret"

# Projeto MCP Vercel separado (Root Directory apps/mcp-server): configure nele
# OMNIA_MCP_EXCHANGE_SECRET com o mesmo valor de servidor acima e as variáveis:
# OMNIA_API_BASE_URL="https://omnia.example.com"
# OMNIA_MCP_ALLOWED_HOSTS="tasks-mcp.example.com"
# OMNIA_MCP_ALLOWED_ORIGINS=""
# Nenhuma chave pessoal omnia_api_ ou omnia_mcp_ pertence a arquivos .env.

# Geração e refinamento de minuta de ATA — chave dedicada e exclusiva a esta feature
# (service account própria, escopo mínimo). O modelo, o esforço de raciocínio e o prompt
# não vêm de env var: ficam em omnia_ata_minuta_settings, editáveis em Configurações → Atas.
OPENAI_ATA_MINUTA_API_KEY="sk-svcacct-..."

# Malotes Digitais (produção: Gmail SMTP)
GMAIL_SMTP_USER="conta-corporativa@gmail.com"
GMAIL_SMTP_APP_PASSWORD="senha-de-app-do-gmail"

# Opcional para testes locais: SMTP alternativo, como Mailpit.
# MALOTE_SMTP_HOST="127.0.0.1"
# MALOTE_SMTP_PORT="55425"
# MALOTE_SMTP_SECURE="false"

# Instructions:
# 1. Copy this file to apps/web-next/.env.local and fill in the real values
# 2. For Vercel: set these same variables in Settings → Environment Variables
# 3. Only variables prefixed with NEXT_PUBLIC_ are available in the browser
# 4. Never commit .env.local to version control (already in .gitignore)
