# Supabase Configuration (required)
NEXT_PUBLIC_SUPABASE_URL="https://your_project_id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Malotes Digitais (produção: Gmail SMTP)
GMAIL_SMTP_USER="conta-corporativa@gmail.com"
GMAIL_SMTP_APP_PASSWORD="senha-de-app-do-gmail"

# Opcional para testes locais: SMTP alternativo, como Mailpit.
# MALOTE_SMTP_HOST="127.0.0.1"
# MALOTE_SMTP_PORT="55425"
# MALOTE_SMTP_SECURE="false"

# Instructions:
# 1. Copy this file to apps/web-next/.env.local and fill in the real values
# 2. For Vercel: set these same variables in Settings → Environment Variables
# 3. Only variables prefixed with NEXT_PUBLIC_ are available in the browser
# 4. Never commit .env.local to version control (already in .gitignore)
