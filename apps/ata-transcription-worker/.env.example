SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_ATA_TRANSCRIPTION_API_KEY=your-dedicated-openai-transcription-api-key
# Segredo compartilhado com a edge function, que acorda o worker quando há trabalho.
WORKER_WAKE_SECRET=generate-a-long-random-value
# Cloudflare R2 (áudios privados das transcrições). Nunca exponha no navegador.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=omnia-ata-audio
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
